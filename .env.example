PORT=3000
MONGODB_URI=
JWT_SECRET=
GROQ_API_KEY=
NODE_ENV=development

# --- Old Paper / AI extraction (add any; best available is used) ---
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
OPENAI_API_KEY=

# Local Ollama vision (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=gemma4:e4b

# PDF page rendering (required for image PDFs on Windows)
POPPLER_BIN_PATH=

# Provider priority: try each in order; if all fail → admin contact message
AI_VISION_PROVIDER_ORDER=gemini,ollama,ocr,openai
ADMIN_CONTACT_MESSAGE=All AI providers failed. Contact the ExamSaathi creator to fix API keys or Poppler setup.

OFFICIAL_PAPER_MIN_MATCH_RATIO=0.8
OFFICIAL_PAPER_DURATION_MINUTES=120
# Phase 2: papers per extract job (1 = one paper; 0 = all pending sequentially)
OFFICIAL_PAPER_EXTRACT_BATCH=1
# CET papers typically have 150 MCQs — used for "sync remaining" gap detection
OFFICIAL_PAPER_EXPECTED_QUESTIONS=150
IMAGEKIT_PRIVATE_KEY=
OFFICIAL_PAPER_IMAGE_FALLBACK=imagekit
DEFAULT_EXTRACT_PROVIDER=ocr
# Phase 2 default when no provider chosen in UI/API
GEMINI_VISION_MODEL=gemini-2.0-flash
OPENAI_VISION_MODEL=gpt-4o-mini
# Cap pages per PDF during AI extraction (0 = no cap)
OFFICIAL_PAPER_MAX_PAGES=0
# Poppler render DPI for PDF→image (lower = less memory)
PDF_RENDER_DPI=150

# RSMSSB archive URLs (optional overrides)
RSMSSB_QP_ARCHIVE_URL=https://rsmssb.rajasthan.gov.in/show_archived?menuName=Xj4lCb9vGxpQnfLs/xlZ2g==
RSMSSB_AK_ARCHIVE_URL=https://rsmssb.rajasthan.gov.in/show_archived?menuName=AGDAnN3xlANlxQ9BZvzaeg==

JINA_API_KEY=
TAVILY_API_KEY=
CLIENT_URL=http://localhost:3000
