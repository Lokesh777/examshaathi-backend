PORT=3000
MONGODB_URI=
JWT_SECRET=
GROQ_API_KEY=
NODE_ENV=development

# Frontend origins allowed for CORS (comma-separated extras in CLIENT_URLS)
CLIENT_URL=http://localhost:3000
CLIENT_URLS=https://examshaathicom.vercel.app,https://examshaathi.com,https://www.examshaathi.com

# Set true only if you need Swagger in production (https://<api-host>/api-docs)
ENABLE_SWAGGER=false

# --- Auth / email (required for login OTP & password reset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER=
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=

# --- Contact → Google Sheet (optional webhook preferred) ---
GOOGLE_SHEETS_CONTACT_ID=
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Old Paper / AI extraction ---
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=gemma4:e4b
POPPLER_BIN_PATH=
AI_VISION_PROVIDER_ORDER=gemini,ollama,ocr,openai
ADMIN_CONTACT_MESSAGE=All AI providers failed. Contact the ExamSaathi creator to fix API keys or Poppler setup.
OFFICIAL_PAPER_MIN_MATCH_RATIO=0.8
OFFICIAL_PAPER_DURATION_MINUTES=120
OFFICIAL_PAPER_EXTRACT_BATCH=1
OFFICIAL_PAPER_EXPECTED_QUESTIONS=150
IMAGEKIT_PRIVATE_KEY=
OFFICIAL_PAPER_IMAGE_FALLBACK=imagekit
DEFAULT_EXTRACT_PROVIDER=ocr
GEMINI_VISION_MODEL=gemini-2.0-flash
OPENAI_VISION_MODEL=gpt-4o-mini
OFFICIAL_PAPER_MAX_PAGES=0
PDF_RENDER_DPI=150

RSMSSB_QP_ARCHIVE_URL=https://rsmssb.rajasthan.gov.in/show_archived?menuName=Xj4lCb9vGxpQnfLs/xlZ2g==
